# Input audit only: pinned vcpkg helpers may unpack LOCAL tools, never compile codecs.
# Do not use vcpkg --only-downloads as proof: its pinned implementation masks errors.
cmake_minimum_required(VERSION 3.21)
set(VCPKG_BASE_VERSION "${BOOTSTRAP_TOOL_DATE}")
set(_VCPKG_NO_DOWNLOADS ON)
set(VCPKG_ROOT_DIR "${BOOTSTRAP_ROOT}")
set(SCRIPTS "${VCPKG_ROOT_DIR}/scripts")
set(BUILDTREES_DIR "${BOOTSTRAP_AUDIT}/buildtrees")
set(PACKAGES_DIR "${BOOTSTRAP_AUDIT}/packages")
set(_VCPKG_INSTALLED_DIR "${BOOTSTRAP_AUDIT}/installed")
set(TARGET_TRIPLET x64-windows-static)
set(_HOST_TRIPLET x64-windows-static)
set(PORT codec-input-audit)
set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_HOST_IS_WINDOWS ON)
set(VCPKG_TARGET_IS_WINDOWS ON)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
include("${SCRIPTS}/ports.cmake")
# ports.cmake normally initializes these only in its BUILD branch. This audit
# deliberately executes no BUILD port, so supply the same native helper context.
set(HOST_TRIPLET "${_HOST_TRIPLET}")
include("${SCRIPTS}/cmake/vcpkg_common_definitions.cmake")
set(ENV{VCPKG_COMMAND} "${VCPKG_ROOT_DIR}/vcpkg.exe")
file(MAKE_DIRECTORY "${CURRENT_BUILDTREES_DIR}")
set(CURRENT_HOST_INSTALLED_DIR "${_VCPKG_INSTALLED_DIR}/${_HOST_TRIPLET}")

# The host helper port installs only its pinned scripts and Meson source. It
# runs no compiler; its ordinary SHA512/patch checks and no-download guard apply.
set(CURRENT_PACKAGES_DIR "${CURRENT_HOST_INSTALLED_DIR}")
set(PORT vcpkg-cmake)
set(CURRENT_PORT_DIR "${VCPKG_ROOT_DIR}/ports/vcpkg-cmake")
include("${CURRENT_PORT_DIR}/portfile.cmake")
set(PORT vcpkg-cmake-get-vars)
set(CURRENT_PORT_DIR "${VCPKG_ROOT_DIR}/ports/vcpkg-cmake-get-vars")
include("${CURRENT_PORT_DIR}/portfile.cmake")
set(PORT vcpkg-tool-meson)
set(CURRENT_PORT_DIR "${VCPKG_ROOT_DIR}/ports/vcpkg-tool-meson")
set(VERSION 1.8.2)
include("${CURRENT_PORT_DIR}/portfile.cmake")
if(NOT EXISTS "${SCRIPT_MESON}")
    message(FATAL_ERROR "Pinned Meson helper was not prepared locally")
endif()
file(APPEND "${BOOTSTRAP_AUDIT}/helpers.txt" "MESON=${PYTHON3};-I;${SCRIPT_MESON}\n")
foreach(program NASM PERL PYTHON3 NINJA PKGCONFIG)
    vcpkg_find_acquire_program(${program})
    if(NOT ${program})
        message(FATAL_ERROR "Missing cached helper ${program}")
    endif()
    file(APPEND "${BOOTSTRAP_AUDIT}/helpers.txt" "${program}=${${program}}\n")
endforeach()
# Exercise the exact separate MSYS closures used by libvpx, ffnvcodec and ffmpeg.
vcpkg_acquire_msys(LIBVPX_MSYS PACKAGES make perl)
vcpkg_acquire_msys(FFNVCODEC_MSYS PACKAGES make pkg-config)
vcpkg_acquire_msys(FFMPEG_MSYS PACKAGES automake1.16)
file(WRITE "${BOOTSTRAP_AUDIT}/helpers-complete.txt" "LOCAL_INPUTS_CHECKED\n")
