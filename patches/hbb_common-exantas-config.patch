@@ -987,0 +989,24 @@ impl Config {
+    /// Rotate only the public connection ID after the caller verified Office
+    /// authority. Persist/verify before publishing the new in-memory identity.
+    pub fn reset_id_with_backup(expected_id: &str, new_id: &str, protect: impl FnOnce(&Path) -> Result<()>) -> Result<PathBuf> {
+        if new_id.len() != 10 || !new_id.bytes().all(|b| b.is_ascii_digit())
+            || !(1_000_000_000..2_000_000_000).contains(&new_id.parse::<u64>()?) {
+            return Err(anyhow!("Invalid generated identity"));
+        }
+        // Compute encryption before taking CONFIG: a missing machine identity
+        // can fall back to reading the existing key pair.
+        let encrypted = encrypt_str_or_original(new_id, PASSWORD_ENC_VERSION, ENCRYPT_MAX_LEN);
+        if encrypted == new_id || !encrypted.starts_with(PASSWORD_ENC_VERSION) {
+            return Err(anyhow!("Identity encryption unavailable"));
+        }
+        let mut config = CONFIG.write().unwrap();
+        if config.id != expected_id || new_id == expected_id {
+            return Err(anyhow!("Identity changed during maintenance"));
+        }
+        let backup = identity_reset::persist(&Self::file(), encrypted.clone(), protect)?;
+        config.id = new_id.to_owned();
+        config.enc_id = encrypted;
+        config.key_confirmed = false;
+        Ok(backup)
+    }
